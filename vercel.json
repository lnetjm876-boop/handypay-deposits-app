{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron-retry.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/fix-db.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/refresh-token.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/cron-retry",
      "dest": "api/cron-retry.js"
    },
    {
      "src": "/api/fix-db",
      "dest": "api/fix-db.js"
    },
    {
      "src": "/api/refresh-token",
      "dest": "api/refresh-token.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
