{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "api/admin.js", "use": "@vercel/node" },
    { "src": "api/query.js", "use": "@vercel/node" },
    { "src": "api/success.js", "use": "@vercel/node" },
    { "src": "api/pay.js", "use": "@vercel/node" },
    { "src": "api/create-session.js", "use": "@vercel/node" },
    { "src": "api/webhook-hp.js", "use": "@vercel/node" },
    { "src": "api/balance.js", "use": "@vercel/node" },
    { "src": "api/settings.js", "use": "@vercel/node" },
    { "src": "api/ghl-setup.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/cron-retry", "dest": "/api/admin.js?action=cron" },
    { "src": "/api/fix-db", "dest": "/api/admin.js?action=fixdb" },
    { "src": "/api/refresh-token", "dest": "/api/admin.js?action=refresh" },
    { "src": "/api/ghl-setup", "dest": "/api/ghl-setup.js" },
    { "src": "/api/create-native-session", "dest": "/api/create-session.js" },
    { "src": "/api/webhooks/handypay", "dest": "/api/webhook-hp.js" },
    { "src": "/api/balance", "dest": "/api/balance.js" },
    { "src": "/api/settings", "dest": "/api/settings.js" },
    { "src": "/api/query/([^/]+)", "dest": "/api/query.js?paymentIntentId=$1" },
    { "src": "/api/query", "dest": "/api/query.js" },
    { "src": "/success", "dest": "/api/success.js" },
    { "src": "/api/pay", "dest": "/api/pay.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}